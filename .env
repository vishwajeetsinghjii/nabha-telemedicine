# Copy to .env for Docker Compose use. Never commit real secrets.
POSTGRES_DB=nabha_telemedicine
POSTGRES_USER=nabha_app
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_32_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM_SECRET_32_CHARS_MIN
IVR_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_WEBHOOK_SECRET
CORS_ORIGIN=http://localhost:8000
AI_CORS_ORIGINS=http://localhost:5000,http://localhost:8000
FRONTEND_PORT=8000
BACKEND_PORT=5000
AI_PORT=8001
POSTGRES_PORT=5432
VIDEO_PROVIDER=zoom
IVR_PROVIDER=exotel
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
ZOOM_CLIENT_ID=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_SECRET=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_WEBHOOK_SECRET=

# Password reset email delivery (recommended: Resend)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Nabha Telemedicine <no-reply@example.com>
FRONTEND_BASE_URL=http://localhost:8000
PASSWORD_RESET_EXPIRES_MINUTES=30
# Development only: set true to print reset links when email delivery is not configured. Never enable in production.
ALLOW_PASSWORD_RESET_LOG=false
